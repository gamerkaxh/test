<tr><td>ml.p4de.24xlarge</td><td>96</td><td>1152</td><td>8</td><td>NVIDIA A100 80GB</td><td>80 GB</td><td>640 GB</td><td class="pass">Yes (1 GPU)</td><td>TP=1</td><td><strong>$31.56*</strong></td><td>$5,302.08</td><td>$23,041.80</td></tr>
