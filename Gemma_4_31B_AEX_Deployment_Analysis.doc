<tr><td>g6.48xlarge</td><td>192</td><td>768</td><td>8</td><td>NVIDIA L4</td><td>24 GB</td><td>192 GB</td><td class="pass">Yes</td><td>TP=4</td><td><strong>$13.3504</strong></td><td>$2,242.87</td><td>$9,745.79</td></tr>
<tr><td>g5.12xlarge</td><td>48</td><td>192</td><td>4</td><td>NVIDIA A10G</td><td>24 GB</td><td>96 GB</td><td class="warn">Yes (tight, quantization recommended)</td><td>TP=4</td><td><strong>$5.672</strong></td><td>$952.90</td><td>$4,140.56</td></tr>
<tr><td>g5.48xlarge</td><td>192</td><td>768</td><td>8</td><td>NVIDIA A10G</td><td>24 GB</td><td>192 GB</td><td class="pass">Yes</td><td>TP=4</td><td><strong>$16.288</strong></td><td>$2,736.38</td><td>$11,890.24</td></tr>
<tr><td>p4d.24xlarge</td><td>96</td><td>1152</td><td>8</td><td>NVIDIA A100 40GB</td><td>40 GB</td><td>320 GB</td><td class="pass">Yes</td><td>TP=2</td><td><strong>$21.9576</strong></td><td>$3,688.88</td><td>$16,029.05</td></tr>
<tr><td>p4de.24xlarge</td><td>96</td><td>1152</td><td>8</td><td>NVIDIA A100 80GB</td><td>80 GB</td><td>640 GB</td><td class="pass">Yes (single GPU capable)</td><td>TP=1</td><td><strong>$27.4471</strong></td><td>$4,611.11</td><td>$20,036.38</td></tr>
