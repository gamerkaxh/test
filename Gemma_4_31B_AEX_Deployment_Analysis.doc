<tr><td>11</td><td>EC2 Self-Hosted</td><td>p5.48xlarge</td><td>$55.04</td><td>$9,247</td><td>$40,179</td><td>H100 GPUs; fastest possible</td></tr>
<tr><td>12</td><td>AEX &rarr; SageMaker</td><td>ml.p5.48xlarge</td><td>$63.29*</td><td>$10,633</td><td>$46,206</td><td>Fastest; AEX-managed; most expensive</td></tr>
