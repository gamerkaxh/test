<tr><td>p4de.24xlarge</td><td>96</td><td>1152</td><td>8</td><td>NVIDIA A100 80GB</td><td>80 GB</td><td>640 GB</td><td class="pass">Yes (1 GPU)</td><td>TP=1</td><td><strong>$27.4471</strong></td><td>$4,611.11</td><td>$20,036.38</td></tr>
